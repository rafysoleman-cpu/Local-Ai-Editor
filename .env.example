# Optional environment overrides (all are optional).
# Copy to .env only if you need them; the app does not load .env automatically.

# Pin Electron's profile/userData directory (portable installs, automation).
# LAIE_USER_DATA_DIR=C:\Users\you\LocalAIEditorProfile

# Pin the application data directory, skipping the storage-location pointer.
# LAIE_DATA_DIR=D:\LocalAIEditorData

# Disable GPU acceleration if the compositor crashes on a virtualized machine.
# LAIE_DISABLE_GPU=1

# Enable test-only IPC hooks used by the automated end-to-end tests.
# Never enable this for normal use.
# LAIE_TEST_MODE=1

# Ollama base URL is configured in the app (Settings or Model selector),
# not through the environment. Default: http://127.0.0.1:11434
